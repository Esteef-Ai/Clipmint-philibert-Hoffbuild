# API mode (default for `python main.py`, uses MuAPI for everything)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local, and everything the desktop/web app runs)
LLM_PROVIDER=philibert        # philibert (local, no key), gemini, groq or openai
# Philibert: the Ollama Philibert runs, or a "Share my models" address.
PHILIBERT_URL=http://127.0.0.1:11434
PHILIBERT_MODEL=qwen3:8b
PHILIBERT_VISION_MODEL=qwen2.5vl:7b
GEMINI_API_KEY=your_gemini_key_here
# 3.5-flash rather than a newer one on purpose: probed against a real free-tier
# key, 3.6-flash returns 429 (its allowance is spent) and 3.8-flash answers only
# about two times in three. 3.5-flash answered every time. Newer is not better
# when it will not reply.
GEMINI_MODEL=gemini-3.5-flash
# Groq: free, no card, from https://console.groq.com. Used automatically when
# Gemini is busy or its quota is spent -- different company, different capacity.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
LOCAL_WHISPER_MODEL=base
# What does the heavy work -- the same choice as the Processor box under the
# live preview in the app.
# auto finds the fastest thing that actually works here (a GPU video encoder,
# CUDA for transcription when NVIDIA's libraries are installed); cpu never
# touches a GPU. LOCAL_WHISPER_DEVICE, when set to cpu or cuda, still pins
# transcription regardless of this.
PROCESSOR=auto                # auto / gpu / cpu
LOCAL_WHISPER_DEVICE=auto     # auto / cpu / cuda
LOCAL_OUTPUT_DIR=output

# Optional. Forces every rendered short to this exact size. Leave empty to keep
# the native crop size, which is what lets a 1440p source render sharper than
# the 1080p platform minimum.
LOCAL_OUTPUT_RESOLUTION=
